# Site
NEXT_PUBLIC_SITE_URL=https://familycourtaccountant.com

# Lead webhook (Netlify → Environment variables, scopes: Builds + Functions)
Lead_notification_url=
LEAD_NOTIFICATION_URL=

# Google Sheets (Netlify → scopes: Builds + Functions — NOT "Build" only)
# Share the spreadsheet with GOOGLE_SERVICE_ACCOUNT_EMAIL as Editor.
# Tab row headers: Timestamp | Brand | Form Type | Full Name | Email | Phone | Organisation | Message
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=
# Optional: paste base64-encoded key if newlines break in Netlify UI
GOOGLE_PRIVATE_KEY_BASE64=
GOOGLE_SHEET_ID=
GOOGLE_SHEET_TAB_NAME=Sheet16

# Analytics (optional)
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_LINKEDIN_PARTNER_ID=
NEXT_PUBLIC_HOTJAR_SITE_ID=
NEXT_PUBLIC_HOTJAR_SNIPPET_VERSION=6

# Search console
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=
